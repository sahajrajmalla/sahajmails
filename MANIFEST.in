# Top-level metadata
include LICENSE
include README.md
include CHANGELOG.md

# Documentation
recursive-include docs *.md

# Package source, typing marker, and the bundled web UI.
# NOTE: the UI is data, not code — without these lines the entire frontend
# silently disappears from the sdist. See tests/test_packaging.py.
recursive-include sahajmails *.py
include sahajmails/py.typed
recursive-include sahajmails/server/static *
recursive-include sahajmails/assets *

# Tests
recursive-include tests *.py
include tests/data/*

# Never ship these
prune venv
prune .venv
prune figures
global-exclude *.py[cod] __pycache__ .DS_Store
